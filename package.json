{
  "name": "vlmp",
  "version": "0.1.9.8",
  "description": "Very Light Media Player — a featherweight, self-hosted media server with HLS streaming and a Netflix-like web client",
  "type": "module",
  "license": "Apache-2.0",
  "author": "kosm1x",
  "homepage": "https://github.com/kosm1x/vlmp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kosm1x/vlmp.git"
  },
  "bugs": {
    "url": "https://github.com/kosm1x/vlmp/issues"
  },
  "keywords": [
    "media-server",
    "self-hosted",
    "homelab",
    "hls",
    "ffmpeg",
    "plex-alternative",
    "streaming",
    "preact",
    "fastify",
    "sqlite"
  ],
  "scripts": {
    "dev": "tsx watch server/src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server/src/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.1",
    "fastify": "^5.10.0",
    "jose": "^6.2.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
